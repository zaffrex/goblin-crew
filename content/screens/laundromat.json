        { "fx": ["small_squeak_text", "gap"] },
        { "anim": ["magpie", "fly_out"] },
        { "anim": ["gap", "snatch"] },
        { "anim": ["magpie", "fly_in"] },
        { "anim": ["magpie", "key_in"] },
        { "anim": ["ppik", "common.shiver"] },
        { "say": ["ppik", "laundromat.steal"] }
