    },
    {
      "id": "gap_poke_empty",
      "target": "gap",
      "verb": "stretch",
      "show": [
        { "anim": ["jjuk", "common.stretch"] },
        { "say": ["jjuk", "laundromat.gap_poke_empty"] }
