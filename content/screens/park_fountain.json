  "rules": [
    {
      "id": "keeper_wake",
      "target": "keeper",
      "verb": "squeak",
      "when": { "flags": { "fountain.off": false } },
      "do": { "set": { "fountain.off": true } },
      "show": [
        { "anim": ["ppik", "common.squeeze_chicken"] },
        { "fx": ["squeak_text", "ppik"] },
        { "anim": ["keeper", "wake"] },
        { "say": ["keeper", "park_fountain.keeper_wake"] },
        { "anim": ["keeper", "clean_time"] },
        { "anim": ["fountain", "water_off"] },
        { "say": ["ppik", "park_fountain.fountain_off"] }
      ],
      "note": "#1 정답. 관리인이 자명종 탁 → 갸웃 → 벽시계 → 제어판 꾹 → 다시 존다(P1·P2, 설계 0절 KX3)"
    },
    {
      "id": "keeper_wake_clock",
      "target": "alarm_clock",
      "verb": "squeak",
      "when": { "flags": { "fountain.off": false } },
      "do": { "set": { "fountain.off": true } },
      "show": [
        { "anim": ["ppik", "common.squeeze_chicken"] },
        { "fx": ["squeak_text", "ppik"] },
        { "anim": ["keeper", "wake"] },
        { "say": ["keeper", "park_fountain.keeper_wake"] },
        { "anim": ["keeper", "clean_time"] },
        { "anim": ["fountain", "water_off"] },
        { "say": ["ppik", "park_fountain.fountain_off"] }
      ],
      "note": "#1 정답(자명종을 눌렀을 때). keeper_wake와 같은 효과"
    },
    {
      "id": "keeper_wake_done",
      "target": "keeper",
      "verb": "squeak",
      "when": { "flags": { "fountain.off": true } },
      "show": [
        { "anim": ["ppik", "common.squeeze_chicken"] },
        { "fx": ["squeak_text", "ppik"] },
        { "anim": ["keeper", "swat"] },
        { "say": ["keeper", "park_fountain.keeper_done"] }
      ],
      "note": "#2 이미 꺼짐. 눈 감은 채 손만 들어 자명종 탁(P1 3칸 + 눈 감은 덧그림)"
    },
    {
      "id": "keeper_wake_done_clock",
      "target": "alarm_clock",
      "verb": "squeak",
      "when": { "flags": { "fountain.off": true } },
      "show": [
        { "anim": ["ppik", "common.squeeze_chicken"] },
        { "fx": ["squeak_text", "ppik"] },
        { "anim": ["keeper", "swat"] },
        { "say": ["keeper", "park_fountain.keeper_done"] }
      ],
      "note": "#2 이미 꺼짐(자명종을 눌렀을 때)"
    },
    {
      "id": "fountain_stomp_drop",
      "target": "fountain",
      "verb": "stomp",
      "when": { "flags": { "jacket.on_hand": false } },
      "do": { "set": { "jacket.on_hand": true } },
      "show": [
        { "anim": ["mukjik", "sit_corner"] },
        { "fx": ["gon_text", "fountain"] },
        { "fx": ["shake", "fountain"] },
        { "anim": ["jacket", "slide"] },
        { "say": ["mukjik", "park_fountain.drop"] }
      ],
      "note": "#3 정답(주 아하). 모서리 돌에 일부러 털썩 앉기(P4) → ゴォン + 분수대 흔들림 → 재킷이 손으로(P5)"
    },
    {
      "id": "fountain_stomp_done",
      "target": "fountain",
      "verb": "stomp",
      "when": { "flags": { "jacket.on_hand": true } },
      "show": [
        { "anim": ["mukjik", "sit_corner"] },
        { "fx": ["gon_text", "fountain"] },
        { "fx": ["ripple", "duck"] },
        { "say": ["mukjik", "park_fountain.drop_done"] }
      ],
      "note": "#4 이미 손에. 연못 물결, 재킷은 꽉"
    },
    {
      "id": "jacket_reach_wet",
      "target": "jacket",
      "verb": "stretch",
      "when": { "flags": { "fountain.off": false } },
      "do": { "gauge": -1 },
      "show": [
        { "anim": ["jjuk", "common.stretch"] },
        { "fx": ["stretch_text", "jjuk"] },
        { "fx": ["splash", "jjuk"] },
        { "anim": ["jjuk", "common.wet"] },
        { "say": ["jjuk", ["park_fountain.wet", "park_fountain.wet_again"]] }
