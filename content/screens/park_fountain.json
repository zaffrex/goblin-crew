  "spots": {
    "floor": { "x": 376, "y": 244, "free": true, "note": "자리 하나뿐(설계 1-2). 분수대 테두리에 올라서는 자리는 두지 않는다(13절 Q3)" }
  },
  "hotspots": {
    "fountain": { "box": [128, 180, 192, 24], "hintAbility": "stomp", "note": "테두리 앞면 그림 128,180,192×18. 아래 끝 204 > WALK_AREA.top 200이라 바닥 대상(쿵은 모서리 옆 x 339 또는 109)" },
    "jacket": {
      "box": [212, 27, 24, 24],
      "hintAbility": "stretch",
      "variants": [{ "when": { "flags": { "jacket.on_hand": true } }, "box": [249, 100, 24, 24] }],
      "note": "꼭대기(돌우산 위) 그림 214,32,20×14 / 손 그림 252,106,18×18. reachPoint 없음: 장대 대상 점 = 상자 아래 끝 가운데(꼭대기 224,51 못 닿음 / 손 261,124 닿음)"
    },
    "keeper": { "box": [36, 114, 44, 36], "hintAbility": "squeak", "note": "창 전체. 조는 얼굴 그림 40,118,36×30. 말풍선 화자(ADR-0065 개정 #434)" },
    "alarm_clock": { "box": [80, 134, 24, 24], "hintAbility": "squeak", "note": "창턱 닭 자명종 그림 84,140,12×12. プピッ는 관리인과 같은 결과" },
    "duck": { "box": [175, 150, 24, 24], "note": "장난감. 연못 위 그림 180,158,14×12" },
    "guest": { "box": [438, 176, 24, 56], "note": "장난감. 그림 440,176,20×56, 히트 폭만 24(ADR-0007 결정 6). 말풍선 화자" }
  },
  "onEnter": [
    { "anim": ["guest", "wait"] },
    { "say": ["ppik", "park_fountain.enter"] }
